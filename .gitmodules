[submodule "zsh/.my-zsh/plugins/ohmyzsh"]
	path = zsh/.my-zsh/plugins/ohmyzsh
	url = https://github.com/ohmyzsh/ohmyzsh.git
[submodule "zsh/.my-zsh/plugins/zsh-autosuggestions"]
	path = zsh/.my-zsh/plugins/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions
[submodule "zsh/.my-zsh/plugins/zsh-defer"]
	path = zsh/.my-zsh/plugins/zsh-defer
	url = https://github.com/romkatv/zsh-defer.git
[submodule "zsh/.my-zsh/plugins/zsh-history-substring-search"]
	path = zsh/.my-zsh/plugins/zsh-history-substring-search
	url = https://github.com/zsh-users/zsh-history-substring-search
[submodule "zsh/.my-zsh/plugins/zsh-syntax-highlighting"]
	path = zsh/.my-zsh/plugins/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting.git
[submodule "zsh/.my-zsh/plugins/zsh-vi-mode"]
	path = zsh/.my-zsh/plugins/zsh-vi-mode
	url = https://github.com/jeffreytse/zsh-vi-mode.git
[submodule "zsh/.my-zsh/plugins/zsh-you-should-use"]
	path = zsh/.my-zsh/plugins/zsh-you-should-use
	url = https://github.com/MichaelAquilina/zsh-you-should-use.git
